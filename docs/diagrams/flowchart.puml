@startuml
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam shadowing false
skinparam ArrowColor #355070
skinparam classBackgroundColor #EEF4FA
skinparam classBorderColor #355070
title Вариант 10 — алгоритм по особым событиям
|Модель и календарь|
start
:Инициализация параметров, приборов, буфера\nпланирование первых поступлений;
while (Есть события?) is (да)
  :Извлечь ближайшее событие\nперевести Now на время события;
  if (Это поступление?) then (да)
    :Создать заявку и учесть поступление\nспланировать следующее поступление,\nесли лимит генерации не достигнут;
    |Диспетчер выбора|
    :Распределить ранее ожидающие заявки\nпо процедуре назначения ниже;
    |Диспетчер постановки и буфер|
    :Принять новую заявку;
    if (Свободный прибор есть?) then (да)
      |Диспетчер выбора|
      :По запросу диспетчера постановки\nвыбрать прибор по кольцу\nназначить новую заявку напрямую;
      |Приборы и статистика|
      :Начать обслуживание; учесть нулевое ожидание;
      |Модель и календарь|
      :Добавить событие завершения обслуживания;
    else (нет)
      |Диспетчер постановки и буфер|
      if (Свободное место в буфере есть?) then (да)
        :Вставить на первое свободное\nместо от начала без сдвига;
      else (нет)
        :Выбрать заявку с максимальным SourceID\nпри равенстве — самую старую;
        :Учесть отказ; удалить ID из пакета\nвставить новую заявку на то же место;
      endif
    endif
  else (завершение)
    |Приборы и статистика|
    :Учесть завершённую заявку\nосвободить прибор;
  endif
  |Диспетчер выбора|
  while (Есть свободный прибор и непустой буфер?) is (да)
    :Удалить из пакета отсутствующие в буфере ID;
    if (Пакет отсутствует или исчерпан?) then (да)
      :Найти минимальный SourceID в буфере\nзафиксировать ID всех его заявок;
    else (нет)
      :Продолжить текущий пакет;
    endif
    :Извлечь самую новую заявку пакета\nудалить её из буфера и пакета;
    :Найти свободный прибор по кольцу\nсдвинуть указатель на следующий;
    |Приборы и статистика|
    :Начать обслуживание\nучесть время ожидания;
    |Модель и календарь|
    :Добавить завершение: Now + Exp(rate);
    |Диспетчер выбора|
  endwhile (нет)
  |Модель и календарь|
  :ОД1: показать календарь, буфер и приборы;
endwhile (нет)
|Приборы и статистика|
:ОР1: вывести сводные таблицы;
stop
@enduml
