@startuml
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam shadowing false
skinparam ArrowColor #355070
skinparam classBackgroundColor #EEF4FA
skinparam classBorderColor #355070
title Вариант 10 — поступление, отказ и обслуживание
participant "Календарь" as C
participant "Модель" as S
participant "Диспетчер\nпостановки" as P
participant "Буфер" as B
participant "Диспетчер\nвыбора" as V
participant "Приборы" as D
participant "Статистика" as T
C -> S : ближайшее событие; Now = event.Time
alt Поступление снимка
  S -> S : создать заявку; вычислить следующий интервал Uniform(a, b)
  S -> C : добавить следующее поступление, если лимит не достигнут
  S -> T : зарегистрировать поступление
  S -> V : распределить ранее ожидающие заявки
  ref over B,D : Назначение из буфера по Д2Б5 и Д2П2 (цикл ниже)
  S -> P : принять новую заявку
  P -> V : есть свободный прибор после распределения?
  alt Есть свободный прибор, буфер пуст
    P -> V : назначить новую заявку напрямую
    V -> D : найти свободный по кольцу; начать
    D --> S : событие завершения: Now + Exp(rate)
    S -> C : добавить завершение
    S -> T : учесть начало обслуживания; ожидание = 0
  else Все приборы заняты
    P -> B : первое свободное место от начала
    alt Свободное место есть
      P -> B : вставить без сдвига (Д1ОЗ3)
    else Буфер полон
      P -> B : выбрать наибольший SourceID; затем самую старую
      B --> P : вытесняемая заявка и её место
      P -> B : заменить новой заявкой (Д1ОО2)
      P --> S : вытесненная заявка
      S -> V : удалить её ID из текущего пакета
      S -> T : зарегистрировать отказ
    end
  end
else Завершение обслуживания
  S -> D : завершить; освободить прибор
  D --> S : обслуженная заявка
  S -> T : зарегистрировать обслуживание
end
S -> V : распределить ожидающие заявки
loop Пока есть свободный прибор и заявки в буфере
  V -> B : сверить оставшиеся ID пакета с буфером
  alt Текущий пакет отсутствует или исчерпан
    V -> B : выбрать минимальный SourceID; зафиксировать все его ID
    B --> V : новый пакет (Д2Б5)
  else Есть остаток текущего пакета
    note over B,V : Новый приоритетный источник не прерывает пакет.\nНовые заявки не добавляются в зафиксированный пакет.
  end
  V -> B : извлечь самую новую заявку текущего пакета
  V -> D : выбрать свободный прибор по кольцу (Д2П2)
  V -> V : удалить ID из пакета; сдвинуть указатель
  V -> D : начать обслуживание
  S -> T : учесть время ожидания
  D --> S : событие завершения
  S -> C : добавить событие завершения
end
note over S,T : Пошаговый режим ОД1: календарь, буфер, приборы.\nАвтоматический режим ОР1: сводные таблицы.
@enduml
